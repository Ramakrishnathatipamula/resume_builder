# ==========================================
# CAREERFORGE ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE CONFIGURATION (Neon PostgreSQL)
# Get your connection string from https://console.neon.tech
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/careerforge?sslmode=require"

# 2. BETTER AUTH CONFIGURATION
# Base application URL (local development: http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"
# Generated 32-byte secret for session encryption and signing
BETTER_AUTH_SECRET="9a9509d84f95390becd3d1258a98169825a8021a17bbe22910d55940977edc8c"

# 3. AI PROVIDER CONFIGURATION
# Primary LLM provider: Google Gemini API (Get key from https://aistudio.google.com)
GEMINI_API_KEY=""

# (Optional Fallbacks / Alternative Models)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# 4. APPLICATION RUNTIME
NODE_ENV="development"
PORT="3000"

